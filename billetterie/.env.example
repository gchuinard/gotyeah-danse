# Copier en .env et ajuster.

# SQLite — chemin relatif à prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# URL publique de l'appli (liens dans les emails)
APP_BASE_URL="http://localhost:3000"

# Brevo (emails transactionnels) — sans clé, les emails sont loggés en console
# BREVO_API_KEY=
EMAIL_SENDER_NAME="École de danse Desha-Moulin"
EMAIL_SENDER_ADDRESS="billetterie@cours-danse-bergerac.fr"

# Implémentation de placement : baseline | custom (Phase 1)
# PLACEMENT_IMPL=baseline

# Admins autorisés (liste blanche, séparés par des virgules). Le login se fait
# par code à 6 chiffres envoyé à ces adresses (via Brevo ; en dev sans clé,
# le code est loggé en console du serveur).
ADMIN_EMAILS="vous@exemple.fr"

# Secret de signature des cookies de session admin — générer : openssl rand -hex 32
SESSION_SECRET=""
