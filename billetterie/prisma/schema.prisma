// Billetterie — spectacle de fin d'année, Centre Culturel de Bergerac.
//
// Séparation stricte topologie / géométrie :
//  - topologie  = Section / Row / Seat.indexInRow (contiguïté, placement)
//  - géométrie  = Seat.x / y / angle (uniquement pour le rendu SVG)
//
// Pas de colonne de statut sur Seat : l'état d'un siège pour une
// représentation se déduit de l'existence d'un Ticket (occupé) ou d'un
// SeatOverride (bloqué).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Section {
  id    String @id // "gauche" | "centre" | "droite"
  name  String
  order Int
  rows  Row[]
}

model Row {
  id        String  @id // ex. "centre-A" (ids déterministes → seed relançable en upsert)
  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String
  label     String // lettre du rang, A = le plus proche de la scène
  order     Int // 0 = rang A
  seats     Seat[]

  @@unique([sectionId, label])
}

model Seat {
  id         String  @id // ex. "centre-A-03"
  row        Row     @relation(fields: [rowId], references: [id])
  rowId      String
  number     Int // numéro affiché sur le billet (selon numberingScheme)
  indexInRow Int // position dans SA section (contiguïté = indices consécutifs)
  x          Float // géométrie SVG uniquement
  y          Float
  angle      Float // degrés, 0 = axe central, négatif = côté jardin
  removable  Boolean @default(false)
  score      Int     @default(0) // score statique 0-100, ajustable à la main par l'admin

  overrides SeatOverride[]
  tickets   Ticket[]

  @@unique([rowId, indexInRow])
}

model Representation {
  id       String   @id @default(cuid()) // seed : ids fixes ("rep-samedi"), admin : cuid
  title    String // ex. « Samedi 20h30 »
  startsAt DateTime
  isOpen   Boolean  @default(false)

  // Bilan d'organisation (saisi à la main après la soirée, pour l'an prochain).
  // weather         : ancienne météo en texte libre — conservée pour ne rien
  //                   perdre, plus éditée (remplacée par weatherReadings).
  // weatherReadings : relevés structurés début / milieu / fin en JSON
  //                   ({ debut|milieu|fin: { sky, tempC } }, cf. lib/admin/weather.ts).
  weather         String?
  weatherReadings String?
  orgNotes        String? // notes libres : ce qui se vend / pas, prix à ajuster…

  overrides    SeatOverride[]
  bookings     Booking[]
  tickets      Ticket[]
  buvetteItems BuvetteItem[]
}

// Buvette du soir J — saisie manuelle pour le bilan d'organisation : articles
// achetés vs vendus, prix d'achat et de vente → balance (recette − coût). Aide
// à décider l'an prochain (ce qui ne se vend pas, prix à ajuster).
model BuvetteItem {
  id                 String         @id @default(cuid())
  representation     Representation @relation(fields: [representationId], references: [id], onDelete: Cascade)
  representationId   String
  label              String // "Coca", "Eau", "Café"…
  qtyStock           Int            @default(0) // quantité achetée / approvisionnée
  qtySold            Int            @default(0) // quantité vendue
  unitPriceCents     Int            @default(0) // prix unitaire de VENTE
  purchasePriceCents Int            @default(0) // prix unitaire d'ACHAT (coût)
  createdAt          DateTime       @default(now())

  @@index([representationId])
}

// Indisponibilités par représentation (console son, fosse, amovibles non posés…)
model SeatOverride {
  id               String         @id @default(cuid())
  representation   Representation @relation(fields: [representationId], references: [id])
  representationId String
  seat             Seat           @relation(fields: [seatId], references: [id])
  seatId           String
  reason           String // "console_son" | "fosse_avant_scene" | "amovibles_non_poses" | libre

  @@unique([representationId, seatId])
}

// Une demande de places. En `pending`/`paid`, elle consomme de la jauge
// (un compteur), jamais des sièges précis. Les sièges n'existent qu'en Ticket.
model Booking {
  id               String         @id @default(cuid())
  representation   Representation @relation(fields: [representationId], references: [id])
  representationId String

  name      String
  email     String
  phone     String
  partySize Int
  notes     String? // demandes particulières libres (saisi par la famille)
  // Accessibilité PMR (personnes à mobilité réduite) — champ STRUCTURÉ, saisi
  // explicitement par la famille (≠ ancien repérage par mots-clés dans notes).
  // pmrCount = nombre de personnes PMR dans la demande (gère plusieurs PMR sur
  // une même commande) ; 0 = demande non PMR.
  pmrCount      Int     @default(0)
  pmrCompanions Int     @default(0) // places accompagnant à coller aux emplacements PMR (0 = aucune)
  adminNotes String? // annotations internes bénévoles (n° de chèque, contexte…)

  // Remise des billets, choisie par l'admin : "email" (e-billet envoyé par
  // email avec QR) ou "papier" (remis en main — l'admin imprime, aucun envoi
  // auto). Le QR reste le même : scanné pareil à l'entrée.
  ticketMode String @default("email")

  status      String // pending | paid | placed | cancelled | expired
  publicToken String  @unique // UUID — accès page « mes billets »

  // Règlement (saisi au « marquer payée ») — pour la réconciliation de caisse.
  paymentMethod String? // especes | cheque | autre
  amountCents   Int? // montant encaissé en centimes

  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  placedAt   DateTime?
  expiresAt  DateTime?
  remindedAt DateTime? // relance J+7 envoyée (cron) — garantit l'idempotence

  tickets Ticket[]
  events  BookingEvent[]

  @@index([representationId, status])
}

// Journal d'audit d'une demande : une ligne par action admin (ou création),
// avec l'email de l'auteur. Best-effort (un échec de log ne casse pas l'action).
model BookingEvent {
  id         String   @id @default(cuid())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  String
  action     String // code d'action (cf. lib/admin/events.ts : paid, unpaid, placed…)
  detail     String? // contexte court (ex. "espèces · 25 €", "4 → 6 places")
  adminEmail String // qui a agi (email de session) ; "demande en ligne" côté public
  createdAt  DateTime @default(now())

  @@index([bookingId])
}

model Ticket {
  id               String         @id @default(cuid())
  booking          Booking        @relation(fields: [bookingId], references: [id])
  bookingId        String
  representation   Representation @relation(fields: [representationId], references: [id])
  representationId String
  seat             Seat           @relation(fields: [seatId], references: [id])
  seatId           String

  qrToken   String    @unique // UUID v4, aucune donnée embarquée
  scannedAt DateTime?

  // LA contrainte qui rend les doublons impossibles, même entre deux
  // bénévoles qui placent en parallèle : l'émission se fait en transaction.
  @@unique([representationId, seatId])
  @@index([bookingId])
}

// Salle de spectacle enregistrée depuis l'admin (créateur de salle).
// `config` est une VenueConfig en JSON (validée par lib/venue/schema.ts).
// AU PLUS UNE salle est active : l'activer matérialise son plan
// (Section/Row/Seat) directement depuis l'admin — sans reseed ni rebuild.
// Sans salle active : VENUE_ID (fichier) puis la salle intégrée font foi.
model Venue {
  id        String   @id @default(cuid())
  name      String
  config    String // VenueConfig sérialisée
  // Source de l'éditeur : le relevé (notation place.md, couloirs/décalages
  // compris) — « Modifier » rouvre EXACTEMENT ce qui a été saisi. À défaut
  // (salle importée en JSON), la config est re-sérialisée en relevé.
  notation  String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Code de connexion à usage unique (login admin sans mot de passe).
// Les admins autorisés sont la liste blanche ADMIN_EMAILS du .env ;
// seul le HASH du code est stocké.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String // sha256 du code à 6 chiffres
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}
