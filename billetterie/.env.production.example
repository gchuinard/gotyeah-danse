# Copier en .env.production sur le Pi et remplir les valeurs manquantes.
# Ce fichier est lu par docker compose (env_file) — ne JAMAIS commiter la
# version remplie.

NODE_ENV=production

# SQLite sur le volume Docker billetterie-data, monté en /data (compose).
DATABASE_URL=file:/data/prod.db

# URL publique de l'appli (liens dans les emails) — derrière NPM + Cloudflare.
APP_BASE_URL=https://billets.cours-danse-bergerac.fr

# Admins autorisés (liste blanche, séparés par des virgules). Le login se
# fait par code à 6 chiffres envoyé à ces adresses via Brevo — la clé Brevo
# est donc indispensable pour se connecter en production.
ADMIN_EMAILS=

# Secret de signature des cookies de session admin — générer :
#   openssl rand -hex 32
SESSION_SECRET=

# Brevo (emails transactionnels) — sans clé, les emails sont seulement
# loggés en console (à ne pas laisser vide en prod réelle).
BREVO_API_KEY=
EMAIL_SENDER_NAME="École de danse Desha-Moulin"
EMAIL_SENDER_ADDRESS="billetterie@cours-danse-bergerac.fr"

# Implémentation de placement : baseline | custom
PLACEMENT_IMPL=baseline

# Rappels :
# - Le seed de démo ne tourne pas en prod (gardé par NODE_ENV) ; `pnpm db:seed`
#   dans le conteneur crée uniquement le plan de salle et les représentations.
# - Pas de comptes admin à créer : ADMIN_EMAILS ci-dessus fait foi. Ajouter ou
#   retirer un bénévole = éditer cette variable puis `docker compose up -d`.
